# --- Stage A: perception -----------------------------------------------------
# Groq hosts whisper-large-v3. Free tier: 2,000 transcription requests/day.
# Get one at https://console.groq.com/keys  (no credit card)
GROQ_API_KEY=

# Gemini reads on-screen text off video frames. Free tier needs no billing.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pin a model instead of walking the built-in fallback chain. The newest flash
# models are usually the most congested on the free tier, so an older one is
# often FASTER despite being nominally slower.
# GEMINI_MODEL=gemini-3.5-flash
# Set to `none` to skip OCR entirely and run on caption + audio alone. Useful
# when the daily Gemini quota is gone and you still want to test the pipeline.
# OCR_ENGINE=none

# Apify resolves Instagram reels -> media URL + caption + carousel images.
# Free plan: $5/mo credits, no credit card. https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Actor slug used to resolve a single Instagram post/reel URL.
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper

# --- Stage C: verification ---------------------------------------------------
# Google Places lookup is the "does this place actually exist" gate.
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# --- Runtime -----------------------------------------------------------------
# Phase 1 runs as a CLI and needs no database. Phase 2 wires this up.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reeltrip
WORK_DIR=.work
