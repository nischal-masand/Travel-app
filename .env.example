# --- Stage A: perception -----------------------------------------------------
# Groq hosts whisper-large-v3. Free tier: 2,000 transcription requests/day.
# Get one at https://console.groq.com/keys  (no credit card)
GROQ_API_KEY=

# Gemini reads on-screen text off video frames. Free tier needs no billing.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pin a model instead of walking the built-in fallback chain. The newest flash
# models are usually the most congested on the free tier, so an older one is
# often FASTER despite being nominally slower.
# GEMINI_MODEL=gemini-3.5-flash
# Set to `none` to skip OCR entirely and run on caption + audio alone. Useful
# when every provider's daily quota is gone and you still want to test Stage A.
# OCR_ENGINE=none
# Force a single OCR provider instead of the fallback chain: gemini | cloudflare
# OCR_PROVIDER=cloudflare

# --- Second OCR provider (optional but recommended) --------------------------
# On-screen text is a primary evidence source — for a reel with a music track
# and a thin caption it is the ONLY source — so one congested free tier is a
# real fragility. Cloudflare Workers AI needs no credit card and no phone
# verification, and gives 10,000 neurons/day.
#   Account ID: dash.cloudflare.com, right-hand sidebar
#   API token:  My Profile -> API Tokens -> use the "Workers AI" template
# Then compare it against Gemini on real frames before trusting it:
#   npm run ocr:compare -w @reel/server -- "<reel url>"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Apify resolves Instagram reels -> media URL + caption + carousel images.
# Free plan: $5/mo credits, no credit card. https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Actor slug used to resolve a single Instagram post/reel URL.
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper

# --- Stage C: verification ---------------------------------------------------
# Google Places lookup is the "does this place actually exist" gate.
# https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# --- Runtime -----------------------------------------------------------------
# Storage defaults to a SQLite file in WORK_DIR — no install, no signup.
# Leave DATABASE_URL unset unless you are pointing at Turso (libsql://...).
# A postgres:// URL will NOT work with the current driver.
# DATABASE_URL=
WORK_DIR=.work
PORT=3000
